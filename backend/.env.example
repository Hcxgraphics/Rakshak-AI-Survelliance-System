# Rakshak API Environment Configuration

# Server configurations
PORT=8000
LOG_LEVEL=INFO

# Model weights paths (relative to repository root or absolute)
WEAPON_MODEL_PATH=models/weapon/best.pt
VIOLENCE_MODEL_PATH=models/violence/final_model.h5
POLICE_MODEL_PATH=models/police/police_or_danger.h5
ACCIDENT_MODEL_PATH=models/accident/accident_model.pth

# Optional offline weights path for MobileNetV2 features extractor backbone
# If left blank, it will attempt online download if not found in local PyTorch Hub cache
# POLICE_BACKBONE_WEIGHTS=models/police/rtdetr_r50vd_6x_coco_from_paddle.pth

# Default inference thresholds (0.0 to 1.0)
POLICE_THRESHOLD=0.35
WEAPON_THRESHOLD=0.5
VIOLENCE_THRESHOLD=0.6
ACCIDENT_THRESHOLD=0.7

# Live camera frame skip rate
LIVE_FRAME_SKIP=2
